<?xml version="1.0" encoding="utf-8"?>
<!--
    App Actions capabilities so Google Assistant / Android TV search can route
    "play <movie>" / "watch <movie>" queries to MyStream's search deep link
    (mystream://search?q=...). Test locally via the App Actions Test Tool or:
    adb shell am start -a actions.intent.PLAY_MEDIA \
      -e "media.name" "Interstellar" com.mystream.app
    Production Assistant routing (for other users) additionally requires
    submitting this app + capabilities for review in Play Console.
-->
<actions>
    <action intentName="actions.intent.PLAY_MEDIA">
        <fulfillment urlTemplate="mystream://search?q={query}">
            <parameter-mapping
                intentParameter="media.name"
                urlParameter="query" />
        </fulfillment>
    </action>
    <action intentName="actions.intent.GET_MEDIA">
        <fulfillment urlTemplate="mystream://search?q={query}">
            <parameter-mapping
                intentParameter="media.name"
                urlParameter="query" />
        </fulfillment>
    </action>
</actions>
